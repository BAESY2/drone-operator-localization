TELEGRAM_BOT_TOKEN=
TELEGRAM_API_URL=http://127.0.0.1:8000/api/predict
LOG_LEVEL=INFO
PORT=8000
BIND_HOST=127.0.0.1

# Security
API_KEY=change-me-long-random
ALLOW_INSECURE_DEV=true
SECURITY_MODE=strict
RATE_LIMIT_PER_MIN=60
ENABLE_OPENAPI=false
ALLOWED_ORIGINS=http://127.0.0.1:8000,http://localhost:8000

# Optional geo gate (off by default)
REGION=global
# Optional AI enrichment / shortlist rerank (never invents coordinates)
# Prefer entering the key in the UI (localStorage) for local demos.
AI_API_KEY=
AI_BASE_URL=https://api.openai.com/v1
AI_MODEL=gpt-4o-mini
AI_RECON_ENABLE=false

# Copy this file to .env then: python -m src → http://127.0.0.1:8000
# Server API_KEY: leave empty + ALLOW_INSECURE_DEV=true for local open access
# Or set API_KEY and paste the same value in the UI "Server API Key" field
